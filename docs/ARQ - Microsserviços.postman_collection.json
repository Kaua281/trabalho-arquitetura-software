    {
      "name": "ms-vendas",
      "item": [
        {
          "name": "Registrar venda",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Preço obtido do ms-produtos e total calculado\", function () {",
                  "    const venda = pm.response.json();",
                  "    pm.expect(venda.precoUnitario).to.be.above(0);",
                  "    pm.expect(venda.total).to.eql(venda.precoUnitario * venda.quantidade);",
                  "    pm.collectionVariables.set(\"idVenda\", venda.id);",
                  "});",
                  "pm.test(\"Cabeçalho Location presente\", function () {",
                  "    pm.response.to.have.header(\"Location\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"idCliente\": 1,\r\n    \"idProduto\": 3,\r\n    \"quantidade\": 2\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrlVendas}}/api/vendas",
              "host": [
                "{{baseUrlVendas}}"
              ],
              "path": [
                "api",
                "vendas"
              ]
            },
            "description": "Fluxo integrado: consulta o cliente (ms-clientes), consulta o produto e obtém o preço (ms-produtos), dá baixa no estoque (ms-estoque) e grava a venda. Requer os quatro serviços em execução. Confira a baixa em GET {{baseUrlEstoque}}/estoque/produto/3."
          },
          "response": []
        },
